{
  "name": "vouch-protocol",
  "version": "0.1.0-poc",
  "private": true,
  "description": "Selective disclosure for Avalanche Encrypted ERC balances",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:circuits": "circom circuits/balance_at_least.circom --r1cs --wasm --sym -o build -l node_modules",
    "setup": "bash scripts/trusted-setup.sh",
    "build:contracts": "hardhat compile",
    "test": "hardhat test",
    "deploy:fuji": "hardhat run scripts/deploy-fuji.ts --network fuji",
    "demo:fuji": "hardhat run scripts/demo.ts --network fuji"
  },
  "dependencies": {
    "@avalabs/ac-eerc-sdk": "^1.0.0",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.13.0",
    "snarkjs": "^0.7.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "chai": "^4.4.1",
    "hardhat": "^2.22.0",
    "typescript": "^5.5.0"
  }
}
