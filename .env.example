# Avalanche Fuji
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Three accounts: subject, verifier, and a third used to prove that
# replaying someone else's statement fails.
PRIVATE_KEY=
PRIVATE_KEY_2=
PRIVATE_KEY_3=

# From your own eERC deployment (ava-labs/EncryptedERC,
# scripts/deploy-converter.ts). Vouch reads these; it never writes to them.
EERC_ADDRESS=
REGISTRAR_ADDRESS=

# Filled in by scripts/deploy-fuji.ts
VOUCH_REGISTRY_ADDRESS=
